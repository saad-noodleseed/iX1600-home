#!/bin/bash
# Turn finished scan jobs into PDFs and upload them to Google Drive.
# Runs from scanpi-process.path (new job) and scanpi-process.timer (retries).
# Local files are only removed after rclone confirms the upload.
set -u
. /etc/scanpi.conf

SPOOL=/var/lib/scanpi
exec 9>"$SPOOL/.process.lock"
flock -n 9 || exit 0

shopt -s nullglob
for job in "$SPOOL"/incoming/scan_*/; do
    job=${job%/}
    name=$(basename "$job")
    sub=""
    if [ -n "$SUBDIR_FORMAT" ]; then
        # Folder date comes from the job name (scan_YYYY-MM-DD_HHMMSS).
        sub=$(date -d "${name:5:10}" +"$SUBDIR_FORMAT")/
    fi
    mkdir -p "$SPOOL/outbox/$sub"
    out="$SPOOL/outbox/$sub$name.pdf"

    echo "processing $name"
    if img2pdf "$job"/page*.{jpg,tiff} -o "$out"; then
        rm -rf "$job"
    else
        echo "PDF failed for $name, moving to failed/"
        mkdir -p "$SPOOL/failed"
        mv "$job" "$SPOOL/failed/"
        rm -f "$out"
    fi
done

# Upload; rclone move deletes each local file only once it is safely uploaded.
# Skip when there's nothing to send: listing Drive alone takes ~50s on the Pi.
# --no-traverse checks just our files instead of listing the whole destination.
if [ -n "$(find "$SPOOL/outbox" -name '*.pdf' -print -quit)" ]; then
    rclone move "$SPOOL/outbox" "$DEST" --include '*.pdf' --delete-empty-src-dirs \
        --no-traverse --retries 3 --log-level INFO \
        || echo "upload failed, will retry on next run"
fi

# A scan that finished while we ran doesn't re-trigger the path unit, so go again.
# Failed jobs were moved to failed/, so this can't loop forever.
jobs=("$SPOOL"/incoming/scan_*/)
if [ ${#jobs[@]} -gt 0 ]; then exec "$0"; fi
